{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".test-dist",
    "target": "ES2022",
    "verbatimModuleSyntax": false
  },
  "include": [
    "lib/calculations.ts",
    "lib/optimizer.ts",
    "lib/process-templates.ts",
    "lib/scenarios.ts",
    "lib/version.ts",
    "scripts/generate-replication.ts",
    "tests/**/*.test.ts"
  ]
}
