# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test-dist
/.tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iCloud Drive / multi-machine sync safety
*.icloud
.nosync
**/.DS_Store
# Large or frequently changing folders that shouldn't travel through iCloud
.turbo/
*.log
playwright-report/
test-results/

# generated article exports (regenerated on demand from the .md source)
docs/articles/**/*.docx
docs/articles/**/*.rtf
